DATABASE_URL=postgresql+psycopg://reservations:reservations@localhost:5432/reservations

# Sign JWT access tokens. Any random string works locally; the code falls back
# to an insecure default if this is unset, so ALWAYS set a real value outside dev.
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origin allowed to call the API via CORS (the Vite dev server by default).
FRONTEND_ORIGIN=http://localhost:5173
